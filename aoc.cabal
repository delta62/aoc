cabal-version:        3.0
name:                 aoc
version:              0.1.0.0
license:              MIT
license-file:         LICENSE
author:               Sam Noedel
maintainer:           sam.noedel@gmail.com
build-type:           Simple
extra-doc-files:      CHANGELOG.md

common shared
    ghc-options:      -Wall
    default-language: Haskell2010
    build-depends:    base ^>=4.17.2.1

library
    import:           shared
    hs-source-dirs:   lib
    build-depends:    array ^>=0.5.4.0, containers ^>=0.7, regex-pcre ^>=0.95.0.0
    exposed-modules:  Day01, Day02, Day03, Day04
    other-modules:    Util

executable runner
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    aoc

test-suite test
    import:           shared
    build-depends:    HUnit ^>=1.6.2.0, containers ^>=0.7
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:    Day01Test, Day02Test, Day03Test, Day04Test
    build-depends:    aoc
